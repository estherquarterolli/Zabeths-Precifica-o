{
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.4",
      "config": { "includeFiles": ["includes/**"] }
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/$", "dest": "/index.php" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
